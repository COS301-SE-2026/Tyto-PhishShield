{
	"name": "tyto-phishshield",
	"private": true,
	"packageManager": "pnpm@11.1.1",
	"scripts": {
		"bootstrap": "pnpm install",
		"update:all": "pnpm -r up --latest",
		"build:all": "pnpm -r --if-present build",
		"test:all": "pnpm -r --if-present test",
		"dev:all": "pnpm -r --if-present start:dev",
		"prod:all": "pnpm -r --if-present start:prod",
		"lint:all": "pnpm -r --if-present lint",
		"build:website": "pnpm --filter website build",
		"dev:website": "pnpm --filter website dev",
		"lint:website": "pnpm --filter website lint",
		"test:website": "pnpm --filter website test",
		"preview:website": "pnpm --filter website preview",
		"serve:website": "pnpm --filter website serve",
		"build:api-gateway": "pnpm --filter api-gateway build",
		"dev:api-gateway": "pnpm --filter api-gateway start:dev",
		"prod:api-gateway": "pnpm --filter api-gateway start:prod",
		"lint:api-gateway": "pnpm --filter api-gateway lint",
		"test:api-gateway": "pnpm --filter api-gateway test",
		"build:accounts-service": "pnpm --filter accounts-service build",
		"dev:accounts-service": "pnpm --filter accounts-service start:dev",
		"prod:accounts-service": "pnpm --filter accounts-service start:prod",
		"lint:accounts-service": "pnpm --filter accounts-service lint",
		"test:accounts-service": "pnpm --filter accounts-service test",
		"build:outlook-addin": "pnpm --filter office-addin-taskpane build",
		"dev:outlook-addin": "pnpm --filter office-addin-taskpane dev-server",
		"start:outlook-addin": "pnpm --filter office-addin-taskpane start",
		"lint:outlook-addin": "pnpm --filter office-addin-taskpane lint",
		"test:outlook-addin": "pnpm --filter office-addin-taskpane test",
		"build:mailing-service": "pnpm --filter mailing-service build",
		"dev:mailing-service": "pnpm --filter mailing-service start:dev",
		"prod:mailing-service": "pnpm --filter mailing-service start:prod",
		"lint:mailing-service": "pnpm --filter mailing-service lint",
		"test:mailing-service": "pnpm --filter mailing-service test",
		"build:report-service": "pnpm --filter report-service build",
		"dev:report-service": "pnpm --filter report-service start:dev",
		"prod:report-service": "pnpm --filter report-service start:prod",
		"lint:report-service": "pnpm --filter report-service lint",
		"test:report-service": "pnpm --filter report-service test",
		"build:xp-service": "pnpm --filter xp-service build",
		"dev:xp-service": "pnpm --filter xp-service start:dev",
		"prod:xp-service": "pnpm --filter xp-service start:prod",
		"lint:xp-service": "pnpm --filter xp-service lint",
		"test:xp-service": "pnpm --filter xp-service test",
		"build:analytics-service": "pnpm --filter analytics-service build",
		"dev:analytics-service": "pnpm --filter analytics-service start:dev",
		"prod:analytics-service": "pnpm --filter analytics-service start:prod",
		"lint:analytics-service": "pnpm --filter analytics-service lint",
		"test:analytics-service": "pnpm --filter analytics-service test",
		"build:education-service": "pnpm --filter education-service build",
		"dev:education-service": "pnpm --filter education-service start:dev",
		"prod:education-service": "pnpm --filter education-service start:prod",
		"lint:education-service": "pnpm --filter education-service lint",
		"test:education-service": "pnpm --filter education-service test",
		"test:backend": "pnpm test:accounts-service && pnpm test:api-gateway && pnpm test:mailing-service && pnpm test:report-service && pnpm test:xp-service && pnpm test:analytics-service && test:education-service",
		"test:backend:e2e": "pnpm --filter accounts-service test:e2e && pnpm --filter api-gateway test:e2e && pnpm --if-present --filter mailing-service test:e2e",
		"build:design-spec": "pnpm --filter design-spec-preview build",
		"dev:design-spec": "pnpm --filter design-spec-preview dev",
		"lint:design-spec": "pnpm --filter design-spec-preview lint",
		"clear:dist": "pnpm -r --if-present run clear:dist",
		"clear:node_modules": "pnpm -r --if-present run clear:node_modules",
		"clear:all": "pnpm run clear:dist && pnpm run clear:node_modules",
		"dc:up": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local up -d",
		"dc:down": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local down",
		"dc:up:build": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local up -d --build",
		"dc:build:api": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build api_app",
		"dc:build:accounts": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build accounts_app",
		"dc:build:report": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build report_app",
		"dc:build:xp": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build xp_app",
		"dc:build:mailing": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build mailing_app",
		"dc:build:education": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build education_app",
		"dc:build:analytics": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build analytics_app",
		"dc:build:website": "docker compose -f project/docker-compose/local-compose.yml --env-file ./project/docker-compose/.env.local build website_app",
		"dc:ps": "docker compose ps",
		"dc:logs": "docker compose logs -f",
		"dc:up:dev-server": "docker compose -f project/docker-compose/dev-compose.yml --env-file ./project/docker-compose/.env.dev up -d --build",
		"dc:down:dev-server": "docker compose -f project/docker-compose/dev-compose.yml --env-file ./project/docker-compose/.env.dev down",
		"demo1:backend": "pnpm dc:up",
		"demo1:frontend": "pnpm start:outlook-addin && pnpm dev:website",
		"server:update:dev": "node ./project/scripts/send-dev-compose.js"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.21",
		"@nestjs/microservices": "^11.1.24",
		"@nestjs/schematics": "^11.1.0",
		"@types/amqplib": "^0.10.8",
		"@types/passport-jwt": "^4.0.1",
		"amqp-connection-manager": "^5.0.0",
		"amqplib": "^2.0.1",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0"
	},
	"dependencies": {
		"@nestjs/axios": "^4.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/swagger": "^11.4.3",
		"@nestjs/typeorm": "^11.0.1",
		"@golevelup/nestjs-rabbitmq": "^9.0.2",
		"@tailwindcss/postcss": "^4.3.0",
		"class-validator": "^0.15.1",
		"class-transformer": "^0.5.1",
		"jwks-rsa": "^4.0.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.20.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"typeorm": "^0.3.29",
		"@golevelup/nestjs-rabbitmq": "^9.0.2"
	}
}