{
	"name": "tyto-phishshield",
	"private": true,
	"packageManager": "pnpm@11.1.1",
	"scripts": {
		"bootstrap": "pnpm install",
		"update:all": "pnpm -r up --latest",
		"build:all": "pnpm -r --if-present build",
		"test:all": "pnpm -r --if-present test",
		"dev:all": "pnpm -r --if-present start:dev",
		"prod:all": "pnpm -r --if-present start:prod",
		"lint:all": "pnpm -r --if-present lint",

		"build:website": "pnpm --filter website build",
		"dev:website": "pnpm --filter website dev",
		"lint:website": "pnpm --filter website lint",
		"test:website": "pnpm --filter website test",

		"build:api-gateway": "pnpm --filter api-gateway build",
		"dev:api-gateway": "pnpm --filter api-gateway start:dev",
		"prod:api-gateway": "pnpm --filter api-gateway start:prod",
		"lint:api-gateway": "pnpm --filter api-gateway lint",
		"test:api-gateway": "pnpm --filter api-gateway test",

		"build:accounts-service": "pnpm --filter accounts-service build",
		"dev:accounts-service": "pnpm --filter accounts-service start:dev",
		"prod:accounts-service": "pnpm --filter accounts-service start:prod",
		"lint:accounts-service": "pnpm --filter accounts-service lint",
		"test:accounts-service": "pnpm --filter accounts-service test",

		"build:outlook-addin": "pnpm --filter office-addin-taskpane build",
		"dev:outlook-addin": "pnpm --filter office-addin-taskpane dev-server",
		"start:outlook-addin": "pnpm --filter office-addin-taskpane start",
		"lint:outlook-addin": "pnpm --filter office-addin-taskpane lint",
		"test:outlook-addin": "pnpm --filter office-addin-taskpane test",

		"build:mailing-service": "pnpm --filter mailing-service build",
		"dev:mailing-service": "pnpm --filter mailing-service start:dev",
		"prod:mailing-service": "pnpm --filter mailing-service start:prod",
		"lint:mailing-service": "pnpm --filter mailing-service lint",
		"test:mailing-service": "pnpm --filter mailing-service test",

		"test:backend": "pnpm --filter accounts-service test && pnpm --filter api-gateway test && pnpm --filter mailing-service test",
		"test:backend:e2e": "pnpm --filter accounts-service test:e2e && pnpm --filter api-gateway test:e2e && pnpm --if-present --filter mailing-service test:e2e",

		"build:design-spec": "pnpm --filter design-spec-preview build",
		"dev:design-spec": "pnpm --filter design-spec-preview dev",
		"lint:design-spec": "pnpm --filter design-spec-preview lint",

		"clear:dist": "pnpm -r --if-present run clear:dist",
		"clear:node_modules": "pnpm -r --if-present run clear:node_modules",
		"clear:all": "pnpm run clear:dist && pnpm run clear:node_modules",

		"dc:up": "docker compose -f project/docker-compose/local-compose.yml up -d --build",
		"dc:down": "docker compose -f project/docker-compose/local-compose.yml down",
		"dc:ps": "docker compose ps",
		"dc:logs": "docker compose logs -f",

		"demo1:backend": "pnpm dc:up",
		"demo1:frontend": "pnpm start:outlook-addin && pnpm dev:website"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.21",
		"@nestjs/schematics": "^11.1.0"
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.0"
	}
}