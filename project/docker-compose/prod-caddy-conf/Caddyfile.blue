prod-caddy.internal {
    tls internal

    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 168h
        }
        format json
    }

    @api path /api/*
    @badApiOrigin {
        path /api/*
        header Origin *
        not header Origin https://capstone-five-guys.dns.net.za
    }

    handle @badApiOrigin {
        respond "Forbidden origin" 403
    }

    handle /socket.io/* {
        reverse_proxy blue_api-gateway_1:3001 blue_api-gateway_2:3001 {
            lb_policy ip_hash
        }
    }

    handle /api/* {
        reverse_proxy blue_api-gateway_1:3001 blue_api-gateway_2:3001 {
            header_up X-Request-ID {http.request.header.X-Request-ID}
            lb_policy round_robin
        }
    }

    handle /addin/* {
        uri strip_prefix /addin
        reverse_proxy blue_addin:8080
    }

    handle {
        reverse_proxy blue_website:5173
    }
}