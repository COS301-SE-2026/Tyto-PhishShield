tyto-phishshield.capstone-five-guys.dns.net.za:443 {
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 168h
        }
        format json
    }

    @api path /api/*
    @badApiOrigin {
        path /api/*
        header Origin *
        not header Origin https://capstone-five-guys.dns.net.za
    }

    handle @badApiOrigin {
        respond "Forbidden origin" 403
    }

    handle /socket.io/* {
        reverse_proxy api-gateway:3001
    }

    handle /api/* {
        reverse_proxy api-gateway:3001 {
            header_up X-Request-ID {http.request.header.X-Request-ID}
        }
    }

    handle /addin/* {
        uri strip_prefix /addin
        reverse_proxy outlook-addin:8080
    }

    handle {
        reverse_proxy website:5173
    }
}