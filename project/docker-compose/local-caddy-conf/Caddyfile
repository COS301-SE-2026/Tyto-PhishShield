:80 {
    @api path /api/*
    @badApiOrigin {
        path /api/*
        header Origin *
        not header Origin https://capstone-five-guys.dns.net.za
        not header Origin https://127.0.0.1
    }

    handle @badApiOrigin {
        respond "Forbidden origin" 403
    }

    handle /api/* {
        reverse_proxy api-gateway:3001
    }

    handle {
        reverse_proxy website:5173
    }
}