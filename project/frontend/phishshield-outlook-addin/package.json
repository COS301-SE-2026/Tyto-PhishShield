{
  "name": "office-addin-taskpane",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "start:prod": "webpack serve --mode production",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch",
    "mock-backend": "tsx mock-backend/server.ts",
    "test": "jest"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "regenerator-runtime": "^0.14.1",
    "@tailwindcss/postcss": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/office-js": "^1.0.591",
    "@types/office-runtime": "^1.0.37",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-office-addins": "^4.0.7",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "office-addin-cli": "^2.0.7",
    "office-addin-debugging": "^6.0.7",
    "office-addin-dev-certs": "^2.0.7",
    "office-addin-lint": "^3.0.7",
    "office-addin-manifest": "^2.1.3",
    "office-addin-prettier-config": "^2.0.2",
    "os-browserify": "^0.3.0",
    "prettier": "^3.8.3",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "5.2.4"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
